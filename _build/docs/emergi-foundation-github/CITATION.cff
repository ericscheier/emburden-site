# Template CITATION.cff for Emergi Foundation projects.
# Individual repos should copy this file to their repo root and
# customise: title, abstract, repository, keywords, DOIs.
#
# https://citation-file-format.github.io/
cff-version: 1.2.0
message: "If you use this Foundation project in academic work, please cite as below."
title: "<project name>"
abstract: >-
  <One-paragraph description. Cite the Foundation as steward.>
type: software
license: AGPL-3.0-or-later
url: https://emrgi.org
repository-code: https://github.com/emergi-foundation/<project>
# Zenodo community "emergi-foundation" — DOIs mint on tag once
# the GitHub -> Zenodo webhook is enabled at the org level.
authors:
  - name: Emergi Foundation
    email: info@emrgi.org
    website: https://emrgi.org
    orcid: https://orcid.org/0000-0002-6628-1389
identifiers:
  # Populated on first release.
  # - type: doi
  #   value: 10.5281/zenodo.XXXXXXX
  #   description: Concept DOI (all versions)
  - type: url
    value: https://github.com/emergi-foundation
    description: Foundation home
keywords:
  - open-science
  - energy-equity
